# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Ktor's optional IntelliJ debugger detector references desktop JVM management
# classes that do not exist on Android and are never used by the bridge runtime.
-dontwarn java.lang.management.ManagementFactory
-dontwarn java.lang.management.RuntimeMXBean

# Netty uses platform JSSE with HTTP/2 and native OpenSSL disabled. These are
# optional desktop providers, logging backends and JVM Flight Recorder hooks.
-dontwarn io.netty.internal.tcnative.**
-dontwarn org.conscrypt.**
-dontwarn org.apache.log4j.**
-dontwarn org.apache.logging.log4j.**
-dontwarn jdk.jfr.**
# Netty's optional client trust-error decoration uses LDAP names. Our Netty
# listener does not request client certificates; LocalBridgeClient uses JSSE.
-dontwarn javax.naming.ldap.LdapName
-dontwarn javax.naming.ldap.Rdn

# Netty's ReflectiveChannelFactory invokes this constructor through Class.getConstructor().
# R8 cannot infer the call through Ktor's selected channel class.
-keep,allowoptimization,allowobfuscation class io.netty.channel.socket.nio.NioServerSocketChannel {
    public <init>();
}

# ResourceLeakDetector.addExclusions validates these method names reflectively.
-keepclassmembers class io.netty.buffer.AbstractByteBufAllocator {
    *** toLeakAwareBuffer(...);
}
-keepclassmembers class io.netty.buffer.AdvancedLeakAwareByteBuf {
    *** touch(...);
    *** recordLeakNonRefCountingOperation(...);
}
-keepclassmembers class io.netty.util.ReferenceCountUtil {
    *** touch(...);
}

# Android uses the MethodHandles fallback; field updaters also resolve names
# through Netty's generic cls() helper, which obscures the target from R8.
-keepclassmembers class io.netty.util.concurrent.ConcurrentSkipListIntObjMultimap {
    private static void acquireFenceFallback();
    volatile <fields>;
}
-keepclassmembers class io.netty.util.concurrent.ConcurrentSkipListIntObjMultimap$* {
    volatile <fields>;
}
